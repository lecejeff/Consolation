(version 1)
#### Differential pairs begin ####
# Inner differential pair rule for DP_90R net class based on 6-layer stackup from NextPCB 06161HA2-7628H
(rule dp_inner_90R
	(layer inner)
	(condition "A.inDiffPair('*')")
	(condition "A.hasNetclass('DP_90R')")
	(constraint diff_pair_gap (min 0.1mm)(opt 0.1778mm))
	(constraint diff_pair_uncoupled (max 15mm))
	(constraint track_width (min 0.127mm)(opt 0.2032mm))
	(constraint skew (opt 0.25mm))
	(constraint clearance (min 0.05mm))
)

# Inner differential pair rule for DP_100R net class based on 6-layer stackup from NextPCB 06161HA2-7628H
(rule dp_inner_100R
	(layer inner)
	(condition "A.inDiffPair('*')")
	(condition "A.hasNetclass('DP_100R')")
	(constraint diff_pair_gap (min 0.1mm)(opt 0.1788mm))
	(constraint diff_pair_uncoupled (max 15mm))
	(constraint track_width (min 0.127mm)(opt 0.2275mm))
	(constraint skew (opt 0.25mm))
	(constraint clearance (min 0.05mm))
)

(rule dp_inner_polypour_to_via_clearance
	(layer inner)
	(constraint clearance (min 0.3mm))
	(condition "A.inDiffPair('*') && (A.Type == 'Via' || A.Type == 'Pad') && B.Type == 'Zone'")
)

(rule dp_inner_polypour_to_track_clearance
	(layer inner)
	(constraint clearance (min 0.6mm))
	(condition "A.inDiffPair('*') && A.Type == 'Track' && B.Type == 'Zone'")
)

# Outer differential pair rule for DP_90R net class based on 6-layer stackup from NextPCB 06161HA2-7628H
(rule dp_outer_90R
	(layer outer)
	(condition "A.inDiffPair('*')")
	(condition "A.hasNetclass('DP_90R')")
	(constraint diff_pair_gap (min 0.1mm)(opt 0.1328mm))
	(constraint diff_pair_uncoupled (max 15mm))
	(constraint track_width (min 0.127mm)(opt 0.2481mm))
	(constraint skew (opt 0.25mm))
	(constraint clearance (min 0.05mm))
)

# Outer differential pair rule for DP_100R net class based on 6-layer stackup from NextPCB 06161HA2-7628H
(rule dp_outer_100R
	(layer outer)
	(condition "A.inDiffPair('*')")
	(condition "A.hasNetclass('DP_100R')")
	(constraint diff_pair_gap (min 0.1mm)(opt 0.1775mm))
	(constraint diff_pair_uncoupled (max 15mm))
	(constraint track_width (min 0.127mm)(opt 0.2288mm))
	(constraint skew (opt 0.25mm))
	(constraint clearance (min 0.05mm))
)

(rule dp_outer_polypour_to_via_clearance
	(layer outer)
	(constraint clearance (min 0.3mm))
	(condition "A.inDiffPair('*') && (A.Type == 'Via' || A.Type == 'Pad') && B.Type == 'Zone'")
)

(rule dp_outer_polypour_to_track_clearance
	(layer outer)
	(constraint clearance (min 0.6mm))
	(condition "A.inDiffPair('*') && A.Type == 'Track' && B.Type == 'Zone'")
)

# Rule length matching SDIO signals
(rule length_match_sdio
	(constraint length (min 49mm)(max 51mm))
	(condition "A.NetClass == 'SDIO'")
)
